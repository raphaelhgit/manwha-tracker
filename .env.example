# Backend (dev local)
PORT=3000
DATA_DIR=./data
# Mot de passe admin (écriture). En prod : obligatoire.
ADMIN_PASSWORD=change-me
# Secret HMAC sessions (min 16 caractères). En prod : obligatoire.
SESSION_SECRET=dev-session-secret-change-me
# TRUST_PROXY=1 derrière nginx / Cloudflare
# COOKIE_SECURE=1 force Secure ; =0 désactive (LAN HTTP)

# Docker Compose (voir compose.yaml)
# PORT=3000
# DATA_DIR=/data
# PUBLIC_DIR=/app/frontend/dist
# NODE_ENV=production
# TRUST_PROXY=1
# ADMIN_PASSWORD=<mot de passe fort>
# SESSION_SECRET=<32+ caractères aléatoires>
